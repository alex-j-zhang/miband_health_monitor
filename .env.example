# Mi Band 6 Configuration
# Bluetooth MAC Address (e.g. EC:39:C2:AA:BB:CC)
DEVICE_MAC=XX:XX:XX:XX:XX:XX

# 32-character hexadecimal authentication key obtained from Zepp Life / Huami
AUTH_KEY=0123456789abcdef0123456789abcdef

# --- Telemetry storage (optional, defaults shown) -------------------------
# Directory where JSONL files and mi_band.db are written.
OUTPUT_DIR=data
# Storage backend: jsonl | sqlite | both | none
STORAGE_BACKEND=both
# Seconds to wait for the band to advertise before giving up on a scan.
SCAN_TIMEOUT=90
# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Simulated band demo (no hardware needed) ------------------------------
# Set DEMO_MODE=1 to run against a built-in fake band instead of real BLE.
DEMO_MODE=0

# --- Live web dashboard (optional) -----------------------------------------
# Uncomment to serve the dashboard + HTTP/SSE API after connecting.
# WEB_PORT=8080
# WEB_HOST=127.0.0.1

# --- Band-side history sync (optional, experimental) -----------------------
# Uncomment to fetch the last N days of activity/SpO2 history after connecting.
# HISTORY_DAYS=7
