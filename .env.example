# Mi Band 6 Configuration

# --- Device identity -------------------------------------------------------
# Bluetooth identifier of the band.
#   Linux / Windows : the Bluetooth MAC address, e.g. EC:39:C2:AA:BB:CC
#   macOS           : the CoreBluetooth UUID (run scan_ble.py; MAC is not exposed)
# DEVICE_ID is the cross-platform name; the legacy DEVICE_MAC is still accepted.
DEVICE_ID=XX:XX:XX:XX:XX:XX
# DEVICE_MAC=EC:39:C2:AA:BB:CC

# Optional second discovery criterion: case-insensitive substring of the
# advertised name (e.g. "Mi Smart Band"). Handy on macOS, or when the address
# differs between the phone's view and the PC's view.
# DEVICE_NAME=Mi Smart Band

# 32-character hexadecimal authentication key obtained from Zepp Life / Huami
AUTH_KEY=0123456789abcdef0123456789abcdef

# Optional manual ATT MTU override (bytes, 23-517). Leave unset to auto-detect;
# only set it if you know the negotiated MTU of your adapter/OS.
# BLE_MTU=185

# --- Telemetry storage (optional, defaults shown) -------------------------
# Directory where JSONL files and mi_band.db are written.
OUTPUT_DIR=data
# Storage backend: jsonl | sqlite | both | none
STORAGE_BACKEND=both
# Seconds to wait for the band to advertise before giving up on a scan.
SCAN_TIMEOUT=90
# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Simulated band demo (no hardware needed) ------------------------------
# Set DEMO_MODE=1 to run against a built-in fake band instead of real BLE.
DEMO_MODE=0

# --- Live web dashboard (optional) -----------------------------------------
# Uncomment to serve the dashboard + HTTP/SSE API after connecting.
# WEB_PORT=8080
# WEB_HOST=127.0.0.1

# --- Band-side history sync (optional, experimental) -----------------------
# Uncomment to fetch the last N days of activity/SpO2 history after connecting.
# HISTORY_DAYS=7

# --- ECDH backend diagnostics (optional) -----------------------------------
# auto (default) | native | python
# "native" requires libecdh; "python" forces the vendored pure-Python fallback.
# MIBAND_ECDH_BACKEND=auto
# Point at an explicit native library file (handy on Windows for a self-built DLL).
# MIBAND_ECDH_LIB=C:\path\to\libecdh.dll
